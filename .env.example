# Make a copy of this file named .env (in Cursor: right-click > Duplicate, then rename to .env).
# Put your keys in .env, not here. .env is git-ignored and never leaves your computer.


# ElevenLabs (used only by scripts/generate-audio.mjs)
# Get your key: elevenlabs.io > Developers > API keys
ELEVENLABS_API_KEY=

# One voice per character. Pick voices in ElevenLabs > Voices,
# open a voice and copy its Voice ID.
# Gerald: 61, precise, dry, slightly nervous accountant
ELEVENLABS_VOICE_GERALD=
# Kaia: 24, fast, hyped startup founder
ELEVENLABS_VOICE_KAIA=
# Rosa: 45, warm, loud, Italian-Canadian baker
ELEVENLABS_VOICE_ROSA=
# Damien: 32, slow, deep, theatrical goth
ELEVENLABS_VOICE_DAMIEN=
# Brenda: 35, soft whisper, calm wellness coach
ELEVENLABS_VOICE_BRENDA=
# The Deadline: deep, dramatic, secretly friendly narrator
ELEVENLABS_VOICE_DEADLINE=

# Optional
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Figma (used only by scripts/export-figma-assets.mjs)
# Figma > Settings > Security > Personal access tokens (File content: read-only)
FIGMA_TOKEN=
